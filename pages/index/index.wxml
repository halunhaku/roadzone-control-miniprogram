<view class="page pageIn">
  <view class="hero">
    <view class="mark">RZ</view>
    <view class="heroText">
      <view class="title">高速公路作业区布置系统</view>
      <view class="subtitle">Work Zone Layout Planner</view>
    </view>
  </view>

  <view class="card">
    <view class="cardTitle">作业区布置</view>

    <view class="field">
      <view class="label">作业区起点（桩号）</view>
      <input
        class="input {{errors.start ? 'hasError' : ''}}"
        value="{{p.start}}"
        data-key="start"
        bindinput="onInput"
        placeholder="如 K123+800"
        placeholder-class="ph"
      />
      <view wx:if="{{errors.start}}" class="err">{{errors.start}}</view>
    </view>

    <view class="field">
      <view class="label">作业区长度（m）</view>
      <input
        class="input {{errors.work ? 'hasError' : ''}}"
        type="digit"
        value="{{p.work}}"
        data-key="work"
        bindinput="onInput"
      />
      <view wx:if="{{errors.work}}" class="err">{{errors.work}}</view>
    </view>

    <view class="field">
      <view class="label">结束桩号</view>
      <view class="readonly">{{endStake || '填写起始桩号与长度后自动计算'}}</view>
    </view>

    <view class="field">
      <view class="label">作业区方向</view>
      <view class="seg" role="radiogroup" aria-label="作业区方向">
        <view
          class="segItem {{p.direction === 'up' ? 'active' : ''}}"
          data-value="up"
          bindtap="onDirection"
          role="radio"
          aria-checked="{{p.direction === 'up'}}"
          aria-label="上行"
        >上行</view>
        <view
          class="segItem {{p.direction === 'down' ? 'active' : ''}}"
          data-value="down"
          bindtap="onDirection"
          role="radio"
          aria-checked="{{p.direction === 'down'}}"
          aria-label="下行"
        >下行</view>
      </view>
    </view>

    <view class="field">
      <view class="label">施工位置</view>
      <view class="radioStack" role="radiogroup" aria-label="施工位置">
        <view
          class="radioCard {{p.workSide === 'roadside' ? 'active' : ''}}"
          data-value="roadside"
          bindtap="onWorkSide"
          role="radio"
          aria-checked="{{p.workSide === 'roadside'}}"
          aria-label="路侧"
        >
          <view class="radioDot"></view>
          <text>路侧</text>
        </view>
        <view
          class="radioCard {{p.workSide === 'median' ? 'active' : ''}}"
          data-value="median"
          bindtap="onWorkSide"
          role="radio"
          aria-checked="{{p.workSide === 'median'}}"
          aria-label="中央分隔带"
        >
          <view class="radioDot"></view>
          <text>中央分隔带</text>
        </view>
      </view>
      <view wx:if="{{errors.workSide}}" class="err">{{errors.workSide}}</view>
    </view>

    <view class="field" wx:if="{{p.workSide === 'median'}}">
      <view class="label">占路方式</view>
      <view class="seg" role="radiogroup" aria-label="占路方式">
        <view
          class="segItem {{!p.doubleSide ? 'active' : ''}}"
          data-value="false"
          bindtap="onDoubleSide"
          role="radio"
          aria-checked="{{!p.doubleSide}}"
          aria-label="单侧占路"
        >单侧占路</view>
        <view
          class="segItem {{p.doubleSide ? 'active' : ''}}"
          data-value="true"
          bindtap="onDoubleSide"
          role="radio"
          aria-checked="{{p.doubleSide}}"
          aria-label="双侧占路"
        >双侧占路</view>
      </view>
    </view>

    <view class="field">
      <view class="label">过渡区基准（m）</view>
      <input
        class="input {{errors.taper ? 'hasError' : ''}}"
        type="digit"
        value="{{p.taper}}"
        data-key="taper"
        bindinput="onInput"
      />
      <view wx:if="{{errors.taper}}" class="err">{{errors.taper}}</view>
    </view>

    <view class="field">
      <view class="label">缓冲区基准（m）</view>
      <input
        class="input {{errors.buffer ? 'hasError' : ''}}"
        type="digit"
        value="{{p.buffer}}"
        data-key="buffer"
        bindinput="onInput"
      />
      <view wx:if="{{errors.buffer}}" class="err">{{errors.buffer}}</view>
    </view>
  </view>

  <view class="card">
    <view
      class="cardTitle clickable"
      bindtap="toggleAdvanced"
      role="button"
      aria-label="{{showAdvanced ? '收起高级参数' : '展开高级参数'}}"
      aria-expanded="{{showAdvanced}}"
    >
      <text>高级参数（下游 / 终止区 / 锥桶间距 / 设计速度）</text>
      <text class="chevron {{showAdvanced ? 'open' : ''}}" aria-hidden="true">▾</text>
    </view>
    <view wx:if="{{showAdvanced}}">
      <view class="hint">警告区长度固定为 1,600m。</view>
      <view class="field">
        <view class="label">下游过渡区（m）</view>
        <input
          class="input {{errors.downstream ? 'hasError' : ''}}"
          type="digit"
          value="{{p.downstream}}"
          data-key="downstream"
          bindinput="onInput"
        />
        <view wx:if="{{errors.downstream}}" class="err">{{errors.downstream}}</view>
      </view>
      <view class="field">
        <view class="label">终止区长度（m）</view>
        <input
          class="input {{errors.terminal ? 'hasError' : ''}}"
          type="digit"
          value="{{p.terminal}}"
          data-key="terminal"
          bindinput="onInput"
        />
        <view wx:if="{{errors.terminal}}" class="err">{{errors.terminal}}</view>
      </view>
      <view class="field">
        <view class="label">锥桶间距（现场放样，m）</view>
        <input
          class="input {{errors.coneGap ? 'hasError' : ''}}"
          type="digit"
          value="{{p.coneGap}}"
          data-key="coneGap"
          bindinput="onInput"
        />
        <view wx:if="{{errors.coneGap}}" class="err">{{errors.coneGap}}</view>
      </view>
      <view class="hint">图中锥桶数量仅表示布置走向，现场数量按设定间距放样确定。</view>
      <view class="field">
        <view class="label">设计速度（km/h）</view>
        <view class="seg" role="radiogroup" aria-label="设计速度">
          <view
            class="segItem {{p.speed == 100 ? 'active' : ''}}"
            data-value="100"
            bindtap="onSpeed"
            role="radio"
            aria-checked="{{p.speed == 100}}"
            aria-label="100"
          >100</view>
          <view
            class="segItem {{p.speed == 80 ? 'active' : ''}}"
            data-value="80"
            bindtap="onSpeed"
            role="radio"
            aria-checked="{{p.speed == 80}}"
            aria-label="80"
          >80</view>
        </view>
        <view wx:if="{{errors.speed}}" class="err">{{errors.speed}}</view>
      </view>
    </view>
  </view>

  <button class="generate" bindtap="handleGenerate">生成布置图</button>

  <view class="note">依据《公路养护安全作业规程》JTG H30—2015 示意。正式实施前，请依据道路等级、设计速度、施工类型及当地现行规范复核。</view>
</view>

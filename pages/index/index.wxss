.page {
  padding: 24rpx 24rpx 0;
}

/* ── 品牌区 ── */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 8rpx 28rpx;
}
.mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff9f0a, #ff7a1a);
  color: #fff;
  font-weight: 800;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 159, 10, 0.35);
}
.heroText {
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}
.subtitle {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* ── 表单 ── */
.field {
  margin-bottom: 26rpx;
}
.label {
  font-size: 26rpx;
  color: var(--ink-4);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.input {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 30rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  transition: border-color 0.2s, background-color 0.2s;
}
.input.hasError {
  border-color: var(--red);
  background: rgba(255, 59, 48, 0.08);
}
.ph {
  color: var(--ink-3);
}
.readonly {
  min-height: 84rpx;
  line-height: 1.4;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}
.hint {
  margin: 0 0 20rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}
.err {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--red);
  line-height: 1.4;
}

/* 分段选择（按压即时反馈：按下 100ms 缩放） */
.seg {
  display: flex;
  background: var(--fill);
  border-radius: 14rpx;
  padding: 6rpx;
}
.segItem {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
  transition: transform 100ms ease-out, background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
}
.segItem:active {
  transform: scale(0.97);
}
.segItem.active {
  background: var(--fill-raised);
  color: var(--ink);
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

/* 施工位置卡片 */
.radioStack {
  display: flex;
  gap: 16rpx;
}
.radioCard {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 0;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-4);
  transition: transform 100ms ease-out, background-color 200ms ease, border-color 200ms ease, color 200ms ease;
}
.radioCard:active {
  transform: scale(0.97);
}
.radioCard.active {
  border-color: var(--orange);
  background: var(--accent-bg);
  color: var(--ink);
}
.radioDot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line-2);
  box-sizing: border-box;
  transition: border-color 0.2s, background-color 0.2s;
}
.radioCard.active .radioDot {
  border-color: var(--orange);
  background: var(--orange);
  box-shadow: inset 0 0 0 5rpx var(--fill-raised);
}

/* 高级参数折叠 */
.clickable {
  cursor: pointer;
}
.chevron {
  font-size: 26rpx;
  color: var(--ink-3);
  transition: transform 0.2s;
  display: inline-block;
}
.chevron.open {
  transform: rotate(180deg);
}

/* 生成按钮（flex 居中 + 按压反馈） */
.generate {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 8rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #ff9f0a, #ff7a1a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 26, 0.35);
  transition: transform 100ms ease-out, box-shadow 200ms ease;
}
.generate:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 26, 0.2);
}
.generate::after {
  border: none;
}

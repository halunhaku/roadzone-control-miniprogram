/* ── 全局：Apple 风格（深墨蓝 + 警戒橙，支持深色模式）──────── */

page {
  /* 浅色主题变量（深色覆盖见文末） */
  --bg: #f5f5f7;
  --ink: #1d1d1f;
  --ink-2: #6e6e73;
  --ink-3: #8e8e93;
  --ink-4: #3a3a3c;
  --orange: #ff9f0a;
  --red: #ff3b30;
  --card: #ffffff;
  --fill: #f5f5f7;         /* 输入框 / 分段控件底 */
  --fill-raised: #ffffff;  /* 选中卡片 / 次级按钮底 */
  --line: #e5e5ea;
  --line-2: #d1d1d6;
  --accent-bg: #fff8ec;    /* 选中态浅橙底 */
  --shadow: rgba(0, 0, 0, 0.04);
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.cardTitle {
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.note {
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.6;
  padding: 12rpx 8rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ── 页面入场（300ms，临界阻尼感：静默平滑，不弹跳） ── */
.pageIn {
  animation: pageIn 300ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
}
@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── 深色模式：仅重定义变量，页面全部颜色随之切换 ── */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --ink: #f5f5f7;
    --ink-2: #98989f;
    --ink-3: #98989f;
    --ink-4: #d1d1d6;
    --card: #1c1c1e;
    --fill: #2c2c2e;
    --fill-raised: #2c2c2e;
    --line: #38383a;
    --line-2: #48484a;
    --accent-bg: rgba(255, 159, 10, 0.16);
    --shadow: rgba(0, 0, 0, 0.4);
  }
}
